generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth ---
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  role         String       @default("member") // "admin" | "member"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  generations     Generation[]
  contentSessions ContentSession[]
}

// --- Knowledge Base ---
model KnowledgeChunk {
  id          String                          @id // deterministic IDs from chunk JSON
  category    String
  title       String
  content     String
  sourceFile  String?
  sourceUrl   String?
  sourceType  String?                         // web, youtube, gpt-prompt, strategy-snapshot
  contentType String?                         // reference, strategic, tool, blueprint
  tokenCount  Int?
  metadata    Json?                           // { headingPath, chunkIndex, totalChunks }
  embedding   Unsupported("vector(1536)")?    // pgvector
  createdAt   DateTime                        @default(now())

  @@index([category])
  @@index([sourceType])
  @@index([contentType])
}

// --- Generation History ---
model Generation {
  id          String   @id @default(cuid())
  userId      String
  agentType   String   // "content", "onpage", "technical", "local", etc.
  inputPrompt String
  output      String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agentType])
}

// --- Content Writing ---
model ContentSession {
  id          String           @id @default(cuid())
  userId      String
  brief       Json             // Full ContentBrief JSON
  niche       String           // "legal", "plumber", "general", etc.
  pageType    String           // "service", "location", "blog", "landing"
  title       String           // Display title derived from brief
  status      String           @default("draft") // draft | in_progress | completed
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])
  sections    ContentSection[]

  @@index([userId])
  @@index([status])
}

model ContentSection {
  id           String         @id @default(cuid())
  sessionId    String
  headingLevel Int            // 1, 2, 3, 4
  headingText  String
  intent       String?        // What this section should accomplish
  content      String?        // Generated content (null until generated)
  status       String         @default("pending") // pending | generating | completed | refined
  sortOrder    Int
  metadata     Json?          // { chunksUsed, topScore, rulesApplied, wordCount }
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  session      ContentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// --- Project/Phase Tracking ---
model Phase {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  sortOrder   Int    @default(0)
  tasks       Task[]
}

model Task {
  id         String  @id @default(cuid())
  phaseId    String
  title      String
  status     String  @default("pending") // "done" | "in-progress" | "pending" | "blocked"
  assignedTo String? // "Michael" | "Sardar" | null
  blockedBy  String?
  sortOrder  Int     @default(0)
  phase      Phase   @relation(fields: [phaseId], references: [id])

  @@index([phaseId])
}
