{
  "name": "lnm-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "prisma db push && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "chunk:knowledge": "npx tsx scripts/chunk-knowledge.ts",
    "embed:chunks": "npx tsx scripts/embed-chunks.ts",
    "verify:embeddings": "npx tsx scripts/verify-embeddings.ts",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "db:export": "npx tsx scripts/export-knowledge.ts",
    "db:import": "npx tsx scripts/import-knowledge.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.4",
    "openai": "^6.36.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
